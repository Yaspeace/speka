<Window x:Class="Speka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Speka"
        xmlns:vm="clr-namespace:Speka.ViewModels"
        xmlns:m="clr-namespace:Speka.Models"
        xmlns:ms="clr-namespace:Speka.Models.Specifications"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="Speka" Height="450" Width="800" WindowState="Maximized">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Открыть папку..." Command="{Binding OpenFolderCommand}"/>
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Background="#F5F5F5">
                <Border Background="#ECECEC" BorderBrush="#DDDDDD"
                        BorderThickness="0,0,0,1"
                        Padding="6,6">
                    <TextBlock
                        Text="{Binding CurrentRoot.FullPath}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding CurrentRoot.FullPath}"
                        Foreground="#333"
                        FontWeight="SemiBold"/>
                </Border>
                <Border BorderThickness="0" Padding="6,6" Height="30" CornerRadius="6" Margin="10,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#D4EDDA"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding CurrentRoot.Parent}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding NavigateUpCommand}"/>
                    </Border.InputBindings>
                    <TextBlock Text="📁↰.."/>
                </Border>
                <ListView
                    ItemsSource="{Binding CurrentRoot.Children}"
                    SelectedItem="{Binding SelectedItem}"
                    Background="Transparent" BorderThickness="0"
                    MouseDoubleClick="ListView_MouseDoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Height" Value="30"/>
                            <Setter Property="Padding" Value="6,0"/>
                            <Setter Property="Margin" Value="10,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True"
                                                CornerRadius="6">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="#D4EDDA"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="#2E7D32"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="MouseDoubleClick" Handler="ListViewItem_MouseDoubleClick" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:FileSystemNode}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="Icon" Text="📁" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFile}" Value="True">
                                    <Setter TargetName="Icon" Property="Text" Value="📄"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#EEE"/>

            <TabControl Grid.Column="2" Background="White">
                <TabItem Header="API Overview">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentSpec.ApiOverview.Title}" FontSize="20"/>
                        <TextBlock Text="{Binding CurrentSpec.ApiOverview.Description}"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Paths">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" MinWidth="200"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <ListView Grid.Column="0" ItemsSource="{Binding CurrentSpec.Paths}">
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type ms:ApiPath}">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Black"/>

                        <TextBlock Grid.Column="2" Text="TODO: Редактор методов" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                    </Grid>
                </TabItem>
                <TabItem Header="Schemas">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" MinWidth="200"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <ListView Grid.Column="0" ItemsSource="{Binding CurrentSpec.Models}">
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type ms:ApiModel}">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Black"/>

                        <TextBlock Grid.Column="2" Text="TODO: Редактор моделей" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
